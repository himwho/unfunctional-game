# unfunctional - Level 4 Email Support Server
# Copy this to .env and fill in your values:
#   cp env.example .env

# -- Server ports --
HTTP_PORT=3000
SMTP_PORT=25

# -- Mail domain --
MAIL_DOMAIN=premiumdoorcodes.com
RODNEY_MAILBOX=rodney

# -- Code TTL (seconds) --
CODE_TTL_SECONDS=60

# -- Debug mode (set to true to log codes and expose /api/active-codes) --
DEBUG_LOG_CODES=false

# -- Outbound SMTP relay (required if AWS blocks port 25 outbound) --
# If you use AWS SES:
#   SMTP_RELAY_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_RELAY_PORT=587
#   SMTP_RELAY_USER=<your SES SMTP username>
#   SMTP_RELAY_PASS=<your SES SMTP password>
#
# If you use Mailgun, SendGrid, etc., fill in their SMTP credentials instead.
# If outbound port 25 is unblocked, leave these commented out for direct delivery.

# SMTP_RELAY_HOST=
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASS=
